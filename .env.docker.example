POSTGRES_DB=thpt_pct_pt
POSTGRES_USER=thpt_pct_pt
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=55432

APP_ENV=production
JWT_SECRET=
JWT_PREVIOUS_SECRETS=
