# Public origin and TLS edge. APP_DOMAIN must not include a scheme or path.
APP_ENV=production
APP_ORIGIN=https://portal.example.edu.vn
APP_DOMAIN=portal.example.edu.vn
CADDY_IMAGE=caddy:2.11.4-alpine
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# Database values are examples only. Store real values in the deployment secret.
POSTGRES_DB=thpt_pct_pt
POSTGRES_USER=thpt_pct_pt
POSTGRES_PASSWORD=
POSTGRES_IMAGE=ghcr.io/example/thpt-pct-pt-postgres:FULL_COMMIT_SHA

# Authentication values must be generated per environment and never committed.
JWT_SECRET=
JWT_PREVIOUS_SECRETS=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# Keep application and database host ports on loopback behind the TLS edge.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=4000
POSTGRES_HOST_PORT=55432

PG_POOL_MAX=20
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_MAX_USES=7500
LOG_LEVEL=info
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX_REQUESTS=5
UPLOAD_RATE_LIMIT_MAX_REQUESTS=10
