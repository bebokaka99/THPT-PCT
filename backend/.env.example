NODE_ENV=development
APP_ENV=development
PORT=4000
APP_PUBLIC_URL=http://localhost:5173
LOG_LEVEL=debug
DATABASE_URL=postgresql://thpt_pct_pt:thpt_pct_pt_dev@localhost:55432/thpt_pct_pt
PGHOST=localhost
PGPORT=55432
PGUSER=thpt_pct_pt
PGPASSWORD=thpt_pct_pt_dev
PGDATABASE=thpt_pct_pt
PGSSLMODE=disable
PGSSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=20
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_MAX_USES=7500
JWT_SECRET=replace_with_random_secret_at_least_32_characters
JWT_PREVIOUS_SECRETS=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
JSON_BODY_LIMIT=1mb
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX_REQUESTS=5
UPLOAD_RATE_LIMIT_MAX_REQUESTS=10
